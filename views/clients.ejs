<%- include('partials/head.ejs') %>

<main>
  <form action="/client-add" method="POST">
    <section class="grid">
      <!-- Company name -->
      <label>
        Raison sociale
        <input type="text" name="clientName" placeholder="Entreprise / <%= userProps.userName %>" required />
      </label>

      <!-- Email -->
      <label>
        Email
        <input name="email" placeholder="raton_braqueur@mail.com" required />
      </label>

      <!-- Invoice number -->
      <label>
        Dernier numéro de facture
        <abbr
          title="Si aucune facture n’a été émise pour ce client, ce champ peut rester vide. Le numéro ne sera plus modifiable"
          >ℹ️</abbr
        >
        <input name="lastInvoiceNumber" placeholder="17" type="number" />
      </label>
    </section>

    <section class="grid">
      <!-- Street name  -->
      <label class="label">
        Rue
        <input name="adress" placeholder="<%= userProps.userAdress %>" required />
      </label>

      <!-- City name -->
      <label class="label">
        Ville
        <input name="city" placeholder="<%= userProps.userCity %>" required />
      </label>

      <!-- ZIP code -->
      <label class="label">
        Code postal
        <input name="zipCode" placeholder="<%= userProps.userZipCode %>" required />
      </label>
    </section>
    <input type="hidden" name="userId" value="<%= userId %>" />
    <button type="submit">Ajouter un client</button>
  </form>
  <hr />
  <section class="overflow-auto">
    <% if (clients && clients.length > 0) { %>
    <table class="striped">
      <thead>
        <tr>
          <th>👤 Client</th>
          <th>🏠 Adresse</th>
          <th>✉️ Email</th>
          <th>📜 Facture</th>
          <th>⚙️ Actions</th>
        </tr>
      </thead>
      <tbody>
        <% clients.forEach(function(client) { %>
        <tr>
          <td><%= client.client_name %></td>
          <td><%= client.formattedAdress %></td>
          <td><%= client.client_email %></td>
          <td><%= client.invoice_number %></td>
          <td>
            <form id="form-delete-client" action="/client-delete" method="post" class="grid">
              <input type="hidden" name="recordId" value="<%= client.recordId %>" />

              <span edit-client-id="<%= client.client_id %>" class="is-clickable">✏️</span>
              <span delete-client-id="<%= client.client_id %>" id="span-delete-button-client" class="is-clickable"
                >❌</span
              >
            </form>
          </td>
        </tr>

        <dialog id="<%= client.client_id %>">
          <article>
            <form action="/client-update" method="POST">
              <section class="grid">
                <!-- Company name -->
                <label>
                  Entreprise ou Nom de famille
                  <input type="text" name="clientName" value="<%= client.client_name %>" required />
                </label>

                <!-- Email -->
                <label>
                  Email
                  <input type="email" name="email" value="<%= client.client_email %>" required />
                </label>
              </section>

              <section class="grid">
                <!-- Street name -->
                <label>
                  Adresse
                  <input name="adress" value="<%= client.client_adress %>" required />
                </label>

                <!-- City name -->
                <label>
                  Ville
                  <input name="city" value="<%= client.client_city_name %>" required />
                </label>

                <!-- ZIP code -->
                <label>
                  Code postal
                  <input name="zipCode" value="<%= client.client_zip_code %>" required />
                </label>
              </section>

              <input type="hidden" name="recordId" value="<%= client.recordId %>" />

              <section class="grid">
                <button type="submit">Mettre à jour</button>
                <button type="button">Annuler</button>
              </section>
            </form>
          </article>
        </dialog>

        <% }); %>
      </tbody>
    </table>
    <% } else { %>
    <p class="txt-align-center">Tu n'as pas encore de clients 😞..</p>
    <% } %>
  </section>
  <script src="/scripts/clientFront.js"></script>
</main>

<%- include('partials/footer.ejs') %>
