<section id="invoiceHistoryTab" class="tab-content">
  <% if (invoiceYear && invoiceYear.length > 0) { %> <% invoiceYear.map(year => { %>
  <details name="invoiceYear" data-invoice-year="<%= year %>">
    <summary><%= year %></summary>
    <div class="months-container"></div>
  </details>
  <% }) %> <% } else { %>
  <p>Aucune facture disponible.</p>
  <% } %>
</section>

