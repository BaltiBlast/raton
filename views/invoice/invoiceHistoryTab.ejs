<section id="invoiceHistoryTab" class="tab-content">
  <% if (invoiceYear && invoiceYear.length > 0) { %> <% invoiceYear.map(year => { %>
  <details name="invoiceYear" data-invoice-year="<%= year %>">
    <summary>
      <strong><%= year %></strong>
      <span id="loadingSpinner<%= year %>" aria-busy="false"></span>
    </summary>
    <section class="months-container"></section>
  </details>
  <% }) %> <% } else { %>
  <p>Tu n'as pas encore de factures 😞..</p>
  <% } %>
</section>
