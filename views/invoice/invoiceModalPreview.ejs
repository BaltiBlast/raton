<dialog id="modalInvoicePreview">
  <article>
    <header>Récapitulatif avant envoi :</header>
    <main>
      <head>
        <h4 class="txt-align-center">
          <b><u>Facture n°3 - Juillet 2025</u></b>
        </h4>
      </head>
      <section class="grid">
        <div>
          <b>Emise par :</b>
          <div class="flex-direction-column">
            <span><%= userData.user_first_name %> <%= userData.user_last_name %></span>
            <span><%= userData.user_adress %></span>
            <span><%= userData.user_city_name %> - <%= userData.user_zip_code %></span>
            <span><%= userData.user_email %></span>
          </div>
        </div>
        <div>
          <b>À l'attention de :</b>
          <div id="modalClientData" class="flex-direction-column"></div>
        </div>
      </section>

      <section>
        <table>
          <thead>
            <tr>
              <th>Prestation</th>
              <th>Quantity</th>
              <th>Prix unité (€)</th>
              <th>Prix Total (€)</th>
            </tr>
          </thead>
          <tbody id="modalServicesData"></tbody>
        </table>
        <small>TVA non applicable art.293 B du CGI</small>
      </section>

      <section>
        <p>Informations bancaire</p>
        <div class="flex-direction-column">
          <span><%= userData.user_iban %></span>
          <span><%= userData.user_bic_swift %></span>
          <span><%= userData.user_bank_name %></span>
        </div>
      </section>
    </main>
    <footer class="grid">
      <button id="sendInvoiceButton" type="button">Envoyer la rançon</button>
      <button id="invoicePreviewCloseButton" type="button">revoir les termes</button>
    </footer>
  </article>
</dialog>
